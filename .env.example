# Copy to .env and fill in your values.
APP_ENV=local
AUTH_MODE=supabase
DEV_USER_ID=00000000-dead-beef-0000-000000000001

# DATABASE_URL must use the asyncpg driver for the async SQLAlchemy engine.
# Staging/production should point at Supabase Cloud Postgres.
# DATABASE_URL=postgresql+asyncpg://postgres.your-project:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
#
# Optional local Docker Postgres for local integration or AUTH_MODE=dev.
# Port 5433 matches the docker-compose.yml host mapping (5433:5432).
DATABASE_URL=postgresql+asyncpg://app:secret@localhost:5433/pharmdb

# For modern Supabase projects using asymmetric signing keys (ECC/RSA),
# set the project base URL so the backend can verify JWTs via JWKS.
SUPABASE_URL=https://your-project.supabase.co
# Optional legacy fallback for older HS256 JWT setups.
SUPABASE_JWT_SECRET=

# Comma-separated browser origins allowed to call the backend API.
# Keep localhost for Vite local development; add the Azure Static Web Apps
# origin in staging/production host settings once it exists.
CORS_ORIGINS=http://localhost:5173

# Free key from https://open.fda.gov/apis/authentication/.
# Without it: 1,000 requests/day. With it: 120,000/day. Used by the
# ingestion pipeline only — the FastAPI runtime does not need this.
OPENFDA_API_KEY=
